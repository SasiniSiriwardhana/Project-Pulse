# ==============================================================================
# ProjectPulse - Root Environment Template
# ==============================================================================
# Copy this file to .env in your local environment and fill in the values.
# NEVER commit the actual .env file with secrets into version control.

# Application Server
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/projectpulse_db?schema=public"

# Authentication & JWT Configuration
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="24h"

# Client Web Application
CLIENT_URL="http://localhost:3000"
VITE_API_URL="http://localhost:5000/api"
